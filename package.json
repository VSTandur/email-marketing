{
  "name": "sfmc-email-marketing-qc",
  "version": "1.0.0",
  "description": "Automated Build and QC toolkit for SFMC Journey Builder and email content design",
  "main": "scripts/qc/email-qc.js",
  "scripts": {
    "qc:email": "node scripts/qc/email-qc.js",
    "qc:journey": "node scripts/qc/journey-qc.js",
